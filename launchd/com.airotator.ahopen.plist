<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.airotator.ahopen</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/oxjames/Downloads/CC_testing/股票扫描器/ai-rotator/scripts/local_pipeline.sh</string>
        <string>ah_open</string>
    </array>

    <!-- 08:45 local time, every day. A/HK opens at 09:30. This fires 45 min
         early so the pipeline can land around 09:00-09:10. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>45</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/oxjames/Downloads/CC_testing/股票扫描器/ai-rotator/logs/launchd-ahopen.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/oxjames/Downloads/CC_testing/股票扫描器/ai-rotator/logs/launchd-ahopen.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/oxjames/.local/bin:/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/opt/homebrew/sbin</string>
        <key>HOME</key>
        <string>/Users/oxjames</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>AI_ROTATOR_DB_PATH</key>
        <string>/Users/oxjames/Downloads/CC_testing/股票扫描器/ai-rotator/storage/ai_rotator.db</string>
        <key>AI_ROTATOR_CODEX_BIN</key>
        <string>/Users/oxjames/.local/bin/codex</string>
    </dict>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
